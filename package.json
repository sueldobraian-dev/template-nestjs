{
  "name": "template-nestjs",
  "version": "1.0.0",
  "description": "Template empresarial NestJS en monorepo Nx con CQRS, Pipeline Behaviors, Result Pattern y AsyncLocalStorage",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:verbose": "nx run-many -t test --verbose",
    "start": "node -r tsconfig-paths/register dist/apps/api/apps/api/src/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "lint": "nx run-many -t lint"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@scalar/nestjs-api-reference": "1.2.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@nx/js": "^20.0.0",
    "@nx/nest": "^20.0.0",
    "@nx/node": "^20.0.0",
    "@nx/workspace": "^20.0.0",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.0",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "nx": "^20.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  }
}
